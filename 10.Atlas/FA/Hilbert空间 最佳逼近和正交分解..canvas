{
	"nodes":[
		{"id":"bc576ec63f253814","x":-180,"y":200,"width":400,"height":480,"type":"group","label":"Proof"},
		{"id":"530f8521fef003b4","x":300,"y":240,"width":400,"height":400,"type":"group","label":"充分性"},
		{"id":"e46778a03ece0712","type":"text","text":"Hilbert空间上","x":-480,"y":40,"width":250,"height":60},
		{"id":"a96e6284447c9560","type":"text","text":"距离逼近点列$\\left\\| y-x_{n}\\right\\|\\to m$","x":-140,"y":220,"width":340,"height":60},
		{"id":"2eb3b02226ca7711","type":"text","text":"借由平行四边形不等式估计$\\left\\| x_{m}-x_{n} \\right\\|$","x":-140,"y":340,"width":360,"height":60},
		{"id":"5e9cdffee075fea5","type":"text","text":"出现$\\frac{x_{m}+ x_{n} }{2 }$所以需要凸性.","x":-140,"y":460,"width":250,"height":60},
		{"id":"f4926e6998424f2b","x":-140,"y":580,"width":323,"height":52,"type":"text","text":"闭性保证了最佳逼近点不会掉出去."},
		{"id":"0f9e254b8782a439","type":"text","text":"闭凸子集的最佳逼近存在且唯一.","x":-140,"y":40,"width":280,"height":60},
		{"id":"a45c89910286dc81","x":340,"y":280,"width":250,"height":60,"type":"text","text":"凸性, 直线落在上面"},
		{"id":"256d11b9e22385c9","x":318,"y":406,"width":250,"height":60,"type":"text","text":"在直线上逼近过程中的交叉量就是$\\operatorname{Re}$"},
		{"id":"dc32e31973cec488","x":253,"y":26,"width":380,"height":74,"type":"text","text":"闭凸子集, 最佳逼近当且仅当$\\operatorname{Re}\\left(y-x_0,x_0-x\\right)\\ge 0,\\forall x$"},
		{"id":"4bb544832f233ff0","x":760,"y":33,"width":250,"height":60,"type":"text","text":"闭子空间, 最佳逼近就是差值正交."},
		{"id":"a92ec5fd97176181","x":760,"y":250,"width":250,"height":72,"type":"text","text":"闭子空间, 所以可以反复用$\\operatorname{Re}$的全局性符号约束, 来约束内积为零."},
		{"id":"42115c8160778260","x":1183,"y":19,"width":250,"height":101,"type":"text","text":"可以将闭子空间, 按\"最佳逼近+差值\"的方式分解, 恰好是正交分解."}
	],
